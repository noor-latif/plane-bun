# Bench stack overrides for the root compose variables (isolated project).
# Canonical root .env is never loaded by the bench stack.
LISTEN_HTTP_PORT=8080
LISTEN_HTTPS_PORT=8443
FILE_SIZE_LIMIT=5242880
AWS_S3_BUCKET_NAME=uploads
# Interpolation keys consumed by the root compose `environment:` blocks; must
# match deploy/{api,db,mq}.env exactly, else empty strings would override the
# env_file values inside the containers.
POSTGRES_USER=bench_plane
POSTGRES_PASSWORD=bench-plane-pass-1
POSTGRES_DB=bench_plane
RABBITMQ_USER=bench_plane
RABBITMQ_PASSWORD=bench-plane-pass-2
RABBITMQ_VHOST=bench_plane
AWS_ACCESS_KEY_ID=bench-minio-key
AWS_SECRET_ACCESS_KEY=bench-minio-secret-3

# Reference sizing: match the intended two-vCPU deployment, not the host CPU count.
BENCH_WORKER_CONCURRENCY=2
