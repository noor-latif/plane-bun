# for these required vars.
PORT=3000
LIVE_BASE_PATH=/live
API_BASE_URL=http://plane-bench-api:8000
CORS_ALLOWED_ORIGINS=http://localhost:8080
REDIS_HOST=plane-bench-redis
REDIS_PORT=6379
LIVE_SERVER_SECRET_KEY=bench-live-secret-4
