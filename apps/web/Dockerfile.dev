FROM node:22-alpine

RUN apk add --no-cache libc6-compat
# Set working directory
WORKDIR /app

COPY . .
# Bun as package manager; Node stays for vite/tsdown shebangs
COPY --from=oven/bun:1.4-alpine /usr/local/bin/bun /usr/local/bin/bun
RUN ln -sf /usr/local/bin/bun /usr/local/bin/bunx
RUN bun install
RUN bun run prepare

EXPOSE 3000
VOLUME [ "/app/node_modules", "/app/web/node_modules" ]
CMD ["bun", "run", "dev", "--filter=web"]
